{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parameters for vehicle_velocity_converter",
  "type": "object",
  "definitions": {
    "vehicle_velocity_converter": {
      "type": "object",
      "properties": {
        "speed_scale_factor": {
          "type": "number",
          "default": 1.0,
          "description": "speed scale factor (ideal value is 1.0)"
        },
        "velocity_stddev_xx": {
          "type": "number",
          "default": 0.2,
          "description": "standard deviation for vx [m/s]."
        },
        "angular_velocity_stddev_zz": {
          "type": "number",
          "default": 0.1,
          "description": "standard deviation for yaw rate [rad/s]."
        }
      },
      "required": ["speed_scale_factor", "velocity_stddev_xx", "angular_velocity_stddev_zz"],
      "additionalProperties": false
    }
  },
  "properties": {
    "/**": {
      "type": "object",
      "properties": {
        "ros__parameters": {
          "$ref": "#/definitions/vehicle_velocity_converter"
        }
      },
      "required": ["ros__parameters"],
      "additionalProperties": false
    }
  },
  "required": ["/**"],
  "additionalProperties": false
}
