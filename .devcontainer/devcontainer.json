{
  "name": "Autoware Core Development",
  "image": "ghcr.io/autowarefoundation/autoware:core-devel-jazzy",
  "runArgs": ["--net=host", "--privileged", "--name", "autoware-core-devcontainer"],
  "workspaceFolder": "/home/aw/autoware/",
  "remoteUser": "aw",
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "mounts": [
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}",
      "target": "/home/aw/autoware/src/core/"
    },
    {
      "type": "volume",
      "source": "autoware-core-cache",
      "target": "/home/aw/.cache"
    },
    {
      "type": "volume",
      "source": "autoware-core-config",
      "target": "/home/aw/.config"
    },
    {
      "type": "volume",
      "source": "autoware-core-ccache",
      "target": "/home/aw/.ccache"
    },
    {
      "type": "bind",
      "source": "${localEnv:SSH_AUTH_SOCK}",
      "target": "/ssh-agent"
    }
  ],

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {}
  },

  "containerEnv": {
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}"
  },
  "postCreateCommand": "",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "redhat.vscode-yaml",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
