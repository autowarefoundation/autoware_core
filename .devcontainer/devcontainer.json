{
  "name": "Autoware Core Development",
  "image": "ghcr.io/autowarefoundation/autoware:core-devel-jazzy",
  "runArgs": ["--net=host", "--privileged", "--name", "autoware-core-devcontainer"],
  "workspaceFolder": "/home/aw/autoware/",
  "remoteUser": "aw",
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/scripts/prepare-host-dirs.sh",

  "mounts": [
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}",
      "target": "/home/aw/autoware/src/core/"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/build",
      "target": "/home/aw/autoware/build"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/install",
      "target": "/home/aw/autoware/install"
    },
    {
      "type": "bind",
      "source": "${localWorkspaceFolder}/.devcontainer/log",
      "target": "/home/aw/autoware/log"
    },
    {
      "type": "volume",
      "source": "autoware-core-devcontainer-cache",
      "target": "/home/aw/.cache"
    },
    {
      "type": "volume",
      "source": "autoware-core-devcontainer-config",
      "target": "/home/aw/.config"
    },
    {
      "type": "volume",
      "source": "autoware-core-devcontainer-ccache",
      "target": "/home/aw/.ccache"
    },
    {
      "type": "bind",
      "source": "${localEnv:SSH_AUTH_SOCK}",
      "target": "/ssh-agent"
    }
  ],

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/pre-commit:2": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers-extra/features/npm-packages:latest": {
      "packages": "@openai/codex,@google/gemini-cli"
    },
    "ghcr.io/fjktkm/devcontainer-features/agent-persistence:1": {}
  },

  "containerEnv": {
    "ROS_DOMAIN_ID": "${localEnv:ROS_DOMAIN_ID:0}"
  },
  "postCreateCommand": "sudo chown -R 1000:1000 /home/aw/autoware && bash /home/aw/autoware/src/core/.devcontainer/scripts/setup-bashrc.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-python.python",
        "redhat.vscode-yaml",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
